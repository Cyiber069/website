{
  "name": "acx-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ACX Agent: customer service agent backend (Cloudflare Worker) + dashboard + Chrome extension",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply acx-agent --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node test/e2e/run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@lexical/history": "^0.53.0",
    "@lexical/rich-text": "^0.53.0",
    "draft-js": "^0.11.7",
    "lexical": "^0.53.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
