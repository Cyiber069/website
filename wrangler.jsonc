{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acx-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "acx-agent",
      "database_id": "916e2170-3ef5-48c8-863f-63f71fdc4515",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "rules": [{ "type": "Text", "globs": ["**/*.sql", "**/*.md"], "fallthrough": true }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
