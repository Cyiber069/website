{
  "manifest_version": 3,
  "name": "ACX Agent",
  "version": "0.3.1",
  "description": "Answers ACX customers inside your own WhatsApp, Gmail and TikTok tabs. Controlled from your ACX Agent dashboard.",
  "minimum_chrome_version": "120",
  "permissions": ["alarms", "storage", "tabs", "power", "idle"],
  "optional_permissions": ["debugger"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://mail.google.com/*",
    "https://www.tiktok.com/*",
    "https://*.tiktokcdn.com/*",
    "https://*.tiktokcdn-eu.com/*",
    "https://*.tiktokcdn-us.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.workers.dev/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "sw.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "ACX Agent" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content/core.js", "content/whatsapp.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content/whatsapp-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content/core.js", "content/gmail.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["content/core.js", "content/tiktok.js"],
      "run_at": "document_idle"
    }
  ]
}
