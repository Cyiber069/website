  "text": {
    "accept": "^accept$",
    "too_fast": ["sending messages too fast", "take a rest", "too many messages", "slow down"],
    "dm_suspended": ["temporarily prevented from sending", "can.?t send (or receive )?(direct )?messages", "(messaging|direct messages?) (is|are|has been|have been) (suspended|restricted|disabled|turned off)"],
    "limit_reached": "chat messages limit reached",
    "privacy_blocked": ["privacy settings", "only friends can send messages"],
    "policy_violation": ["violated our community guidelines"],
    "request_pending": ["accepts your message request", "only send up to"],
    "captcha": ["drag the slider", "fit the puzzle", "verify to continue", "rotate the", "select \\d+ objects"],
    "logged_out": ["log in to tiktok", "log in or sign up", "use qr code"],
    "time": "^\\d{1,2}:\\d{2}( ?[ap]m)?$|^\\d{1,2}[/.]\\d{1,2}([/.]\\d{2,4})?$|^yesterday$|^(mon|tue|wed|thu|fri|sat|sun)[a-z]*$|^\\d+ ?[smhdw]( ago)?$|^just now$"
